#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/onlidesk/rustdesk /usr/bin/onlidesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/onlidesk.service ]; then
			rm /etc/systemd/system/onlidesk.service /usr/lib/systemd/system/onlidesk.service /usr/lib/systemd/user/onlidesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/onlidesk/files/systemd/onlidesk.service /usr/lib/systemd/system/onlidesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload onlidesk.service: Unit onlidesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/onlidesk.service:10: Executable path is not absolute: pkill -f "onlidesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/onlidesk.service
		fi
		systemctl daemon-reload
		systemctl enable onlidesk
		systemctl start onlidesk
	fi
fi
